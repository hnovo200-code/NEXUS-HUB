task.spawn(function()
    task.wait(2)
    local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    local function customizeButton(button)  
        if button then  
            button.RichText = true  
            button.Text = '<font color="rgb(255, 0, 0)">NEXUS</font> <font color="rgb(173, 216, 230)">HUB</font>'  
        end  
    end  
    local function customizeSubTitle(textLabel)  
        if textLabel then  
            textLabel.RichText = true  
            textLabel.Text = '<font color="rgb(0, 255, 0)">FLEE THE FACILITY</font>'  
        end  
    end  
    local function searchAndCustomize(parent)  
        for _, child in ipairs(parent:GetDescendants()) do  
            if (child:IsA("TextLabel") or child:IsA("TextButton")) then  
                if child.Text == "NEXUS HUB" then  
                    customizeButton(child)  
                elseif child.Text == "FLEE THE FACILITY" then  
                    customizeSubTitle(child)  
                end  
            end  
        end  
    end  
    for _, gui in ipairs(playerGui:GetChildren()) do  
        if gui:IsA("ScreenGui") then searchAndCustomize(gui) end  
    end  
    searchAndCustomize(game:GetService("CoreGui"))
end)

