local fpsParagraph = helptab:Paragraph({
    Title = "Monitor de FPS",
    Desc = "Calculando FPS..."
})

task.spawn(function()
    local RunService = game:GetService("RunService")
    local lastUpdate = tick()
    local frameCount = 0
    
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastUpdate >= 1 then
            local fps = math.floor(frameCount / (now - lastUpdate))
            pcall(function()
                fpsParagraph:SetDesc("FPS Atual: " .. fps .. " | Ping: " .. math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) .. " ms")
            end)
            frameCount = 0
            lastUpdate = now
        end
    end)
end)

