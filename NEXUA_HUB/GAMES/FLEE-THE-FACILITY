local function saveCustomConfig()
    local data = {
        Language = getgenv().NexusConfig.Language,
        ColorPlayerR = getgenv().NexusConfig.ColorPlayer.R,
        ColorPlayerG = getgenv().NexusConfig.ColorPlayer.G,
        ColorPlayerB = getgenv().NexusConfig.ColorPlayer.B,
        ColorPCR = getgenv().NexusConfig.ColorPC.R,
        ColorPCG = getgenv().NexusConfig.ColorPC.G,
        ColorPCB = getgenv().NexusConfig.ColorPC.B,
        ColorFreezeR = getgenv().NexusConfig.ColorFreeze.R,
        ColorFreezeG = getgenv().NexusConfig.ColorFreeze.G,
        ColorFreezeB = getgenv().NexusConfig.ColorFreeze.B,
        ColorExitR = getgenv().NexusConfig.ColorExit.R,
        ColorExitG = getgenv().NexusConfig.ColorExit.G,
        ColorExitB = getgenv().NexusConfig.ColorExit.B,
        AutoLoad = getgenv().NexusConfig.AutoLoad,
        PlayerESPState = getgenv().NexusConfig.PlayerESPState,
        ComputerESPState = getgenv().NexusConfig.ComputerESPState,
        ExitESPState = getgenv().NexusConfig.ExitESPState,
        FullBrightState = getgenv().NexusConfig.FullBrightState,
        AutoHackingState = getgenv().NexusConfig.AutoHackingState,
        ThirdPersonState = getgenv().NexusConfig.ThirdPersonState,
        SpeedVal = getgenv().NexusConfig.SpeedVal
    }
    pcall(function() writefile(configFilePath, HttpService:JSONEncode(data)) end)
end

local function loadCustomConfig()
    if readfile and isfile and isfile(configFilePath) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(configFilePath)) end)
        if success and decoded then
            getgenv().NexusConfig.Language = decoded.Language or "English"
            if decoded.ColorPlayerR then getgenv().NexusConfig.ColorPlayer = Color3.new(decoded.ColorPlayerR, decoded.ColorPlayerG, decoded.ColorPlayerB) end
            if decoded.ColorPCR then getgenv().NexusConfig.ColorPC = Color3.new(decoded.ColorPCR, decoded.ColorPCG, decoded.ColorPCB) end
            if decoded.ColorFreezeR then getgenv().NexusConfig.ColorFreeze = Color3.new(decoded.ColorFreezeR, decoded.ColorFreezeG, decoded.ColorFreezeB) end
            if decoded.ColorExitR then getgenv().NexusConfig.ColorExit = Color3.new(decoded.ColorExitR, decoded.ColorExitG, decoded.ColorExitB) end
            getgenv().NexusConfig.AutoLoad = decoded.AutoLoad or false
            getgenv().NexusConfig.PlayerESPState = decoded.PlayerESPState or false
            getgenv().NexusConfig.ComputerESPState = decoded.ComputerESPState or false
            getgenv().NexusConfig.ExitESPState = decoded.ExitESPState or false
            getgenv().NexusConfig.FullBrightState = decoded.FullBrightState or false
            getgenv().NexusConfig.AutoHackingState = decoded.AutoHackingState or false
            getgenv().NexusConfig.ThirdPersonState = decoded.ThirdPersonState or false
            getgenv().NexusConfig.SpeedVal = decoded.SpeedVal or 16
        end
    end
end

if getgenv().NexusConfig.AutoLoad then loadCustomConfig() end

